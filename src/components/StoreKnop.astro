---
import site from '../data/site.json';
const { lang = 'nl' } = Astro.props;
---
{site.appStoreUrl ? (
  <a class="store" href={site.appStoreUrl}>
    <svg width="20" height="24" viewBox="0 0 20 24" aria-hidden="true"><path fill="currentColor" d="M16.4 12.7c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.5 0 2 .8 3.4.8 1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9-.1 0-2.7-1-2.7-4.1zM13.9 5.1c.7-.9 1.2-2 1-3.2-1 0-2.3.7-3 1.6-.7.8-1.2 2-1.1 3.1 1.2.1 2.3-.6 3.1-1.5z"/></svg>
    <span><small>{lang === 'nl' ? 'Download in de' : 'Download on the'}</small><strong>App Store</strong></span>
  </a>
) : (
  <span class="store soon"><span><small>{lang === 'nl' ? 'Binnenkort in de' : 'Coming soon to the'}</small><strong>App Store</strong></span></span>
)}
