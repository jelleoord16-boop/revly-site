---
import Layout from '../../layouts/VersionTwo.astro';
import Phone from './Phone.astro';
import site from '../../data/site.json';
const {lang='nl'}=Astro.props;const en=lang==='en';const base=en?'/en/':'/';
const features=[
 {title:en?'Your car. In focus.':'Je auto. In beeld.',text:en?'Your mileage, reminders and quick actions together.':'Je kilometerstand, herinneringen en snelle acties bij elkaar.',image:'garage-current.jpg',label:en?'Garage':'Garage'},
 {title:en?'Every trip counts.':'Elke rit telt mee.',text:en?'Find your trips, distance and time on the road.':'Vind je ritten, afstand en tijd onderweg terug.',image:'trips-current.jpg',label:en?'Trips':'Ritten'},
 {title:en?'Keep the story.':'Bewaar het verhaal.',text:en?'Maintenance and documents in your vehicle passport.':'Onderhoud en documenten in je autopaspoort.',image:'passport-current.jpg',label:en?'Vehicle passport':'Autopaspoort'},
 {title:en?'A car you share.':'Samen één auto.',text:en?'Invite someone and keep your vehicle records together.':'Nodig iemand uit en houd je autodossier samen bij.',image:'sharing-current.jpg',label:en?'Car sharing':'Auto delen'},
];
const insights=[
 {id:'consumption',label:en?'Consumption':'Verbruik',title:en?'From fill-ups to insight.':'Van tankbeurt naar inzicht.',text:en?'See how your consumption changes and compare it with the manufacturer rating.':'Zie hoe je verbruik verandert en vergelijk het met de fabrieksopgave.',image:'consumption-current.jpg',detail:en?'Based on the fill-ups you record.':'Op basis van de tankbeurten die je vastlegt.'},
 {id:'costs',label:en?'Costs':'Kosten',title:en?'Know where your money goes.':'Weet waar je geld blijft.',text:en?'Fuel, maintenance, insurance. See your recorded costs together and compare years.':'Tanken, onderhoud, verzekering. Bekijk je geregistreerde kosten bij elkaar en vergelijk jaren.',image:'costs-current.jpg',detail:en?'Detailed cost insights are part of Revly Plus.':'Uitgebreid kosteninzicht hoort bij Revly Plus.'},
];
---
<Layout lang={lang} title={en?'Revly | Drive. Revly remembers the rest.':'Revly | Rij. Revly onthoudt de rest.'}>
<section class="v2-hero v2-revly-hero"><div class="v2-shell v2-hero-copy"><h1>{en?'Drive.':'Rij.'}<br/><span>{en?'Revly remembers the rest.':'Revly onthoudt de rest.'}</span></h1><p class="v2-hero-description">{en?'The logbook for your car. Keep your trips, mileage and maintenance together. Even if your car is older than your phone.':'Het logboek voor je auto. Houd je ritten, kilometers en onderhoud bij elkaar. Ook als je auto ouder is dan je telefoon.'}</p><div class="v2-actions"><a class="v2-button" href="#ontdek">{en?'Discover Revly':'Ontdek Revly'}</a><a class="v2-text-link" href={`${base}app/`}>{en?'See the app':'Kijk in de app'} <span aria-hidden="true">›</span></a></div><p class="v2-hero-free">{en?'Free for your first car.':'Gratis voor je eerste auto.'}</p></div><div class="v2-device-stage" aria-label={en?'Revly app with illustrative car and reminders':'Revly-app met voorbeeldauto en herinneringen'}><div class="v2-device v2-device-centre"><Phone image="garage-current.jpg" alt={en?'Revly Garage with illustrative BMW E30':'Revly Garage met illustratieve BMW E30'} bmw priority/></div><div class="v2-glass v2-hero-trip"><p>{en?'Trip in progress':'Rit bezig'}</p><strong>12,4 <small>km</small></strong><div class="v2-trip-progress"></div><div class="v2-trip-route"><span>{en?'Home':'Thuis'}</span><span>18 min</span><span>{en?'Work':'Werk'}</span></div></div><div class="v2-glass v2-hero-service"><p>{en?'Next service':'Volgende beurt'}</p><strong>34 <small>{en?'days':'dagen'}</small></strong><span>BMW E30</span></div><div class="v2-glass v2-hero-notification"><img src="/revly-logo.png" width="38" height="38" alt=""/><div><strong>{en?'Oil change':'Olie verversen'}</strong><p>{en?'You can change your oil in 300 km. Your car uses 5W30.':'Over 300 km kun je je olie verversen. Je gebruikt 5W30.'}</p></div></div><p class="v2-hero-example">{en?'Edited app preview · BMW E30 and example data':'Bewerkt appvoorbeeld · BMW E30 en voorbeeldgegevens'}</p></div></section>
<section class="v2-intro v2-shell"><h2>{en?'Your car has a story. Keep it together.':'Je auto heeft een verhaal. Houd het bij elkaar.'}</h2><p>{en?'Whether it is your first car or the one you will never forget. Give its trips, maintenance and history a place of their own.':'Je eerste auto of die ene die je nooit meer vergeet. Geef de ritten, het onderhoud en de historie een eigen plek.'}</p></section>
<section class="v2-highlights" id="ontdek"><div class="v2-shell v2-section-heading"><h2>{en?'Get to know Revly.':'Dit is Revly.'}</h2><div class="v2-gallery-controls"><button type="button" data-gallery-dir="-1" aria-label={en?'Previous example':'Vorig voorbeeld'}>‹</button><button type="button" data-gallery-dir="1" aria-label={en?'Next example':'Volgend voorbeeld'}>›</button></div></div><div class="v2-feature-rail" data-feature-rail tabindex="0" aria-label={en?'Explore Revly features':'Ontdek de functies van Revly'}>{features.map(f=><article class="v2-feature"><div><p class="v2-feature-label">{f.label}</p><h3>{f.title}</h3><p>{f.text}</p></div><Phone image={f.image} alt={en?`${f.label} screen in Dutch`:`Scherm ${f.label.toLowerCase()}`}/></article>)}</div><div class="v2-shell v2-gallery-bottom"><a class="v2-text-link" href={`${base}app/`}>{en?'See all app screens':'Bekijk alle appschermen'} <span aria-hidden="true">›</span></a><span>{en?'Swipe to explore':'Swipe en ontdek'}</span></div></section>
<section class="v2-drive" id="onderweg" aria-labelledby="drive-heading"><div class="v2-drive-inner v2-shell"><div class="v2-drive-heading"><p class="v2-overline">{en?'On the road with Revly':'Onderweg met Revly'}</p><h2 id="drive-heading">{en?'You drive.':'Jij rijdt.'}<br/><span>{en?'Revly keeps track.':'Revly houdt bij.'}</span></h2><p>{en?'From a recorded trip to your next maintenance reminder.':'Van een geregistreerde rit naar je volgende onderhoudsmoment.'}</p></div><div class="v2-drive-story"><div class="v2-drive-odometer"><span data-drive-km>214.320</span> km</div><div class="v2-drive-road" aria-hidden="true"><div class="v2-drive-lane"></div><div class="v2-drive-car"><svg width="58" height="104" viewBox="0 0 64 112" fill="none"><rect x="7" y="3" width="50" height="105" rx="17" fill="#3B85FD" stroke="#cddcff" stroke-width="2"/><path d="M14 27Q32 20 50 27L47 39H17z" fill="#1c2438"/><path d="M16 68H48L51 84Q32 96 13 84z" fill="#101a31"/><rect x="12" y="99" width="10" height="5" rx="2" fill="white"/><rect x="42" y="99" width="10" height="5" rx="2" fill="white"/><path d="M7 32v17M57 32v17M7 72v17M57 72v17" stroke="#111923" stroke-width="4"/></svg></div></div><div class="v2-drive-steps"><article class="v2-drive-step is-active" data-drive-step="0"><p class="v2-drive-number">01 / {en?'A trip':'Een rit'}</p><div class="v2-glass v2-drive-notice"><img src="/revly-logo.png" width="42" height="42" alt=""/><div><strong>{en?'Trip recognised':'Rit herkend'}</strong><p>{en?'Home to work, 23 km. Were you driving the BMW?':'Thuis naar werk, 23 km. Reed jij in de BMW?'}</p></div></div><p class="v2-drive-explanation">{en?'Review and confirm your recognised trip.':'Bekijk en bevestig je herkende rit.'}</p></article><article class="v2-drive-step" data-drive-step="1"><p class="v2-drive-number">02 / {en?'The miles add up':'De kilometers tellen op'}</p><div class="v2-glass v2-drive-notice"><img src="/revly-logo.png" width="42" height="42" alt=""/><div><strong>{en?'Mileage updated':'Kilometerstand bijgewerkt'}</strong><p>{en?'Your recorded trips keep your car mileage up to date.':'Je geregistreerde ritten houden de kilometerstand van je auto bij.'}</p><span class="v2-drive-remaining">{en?'Oil change in ':'Olie verversen over '}<span data-drive-remaining>450</span> km</span></div></div><p class="v2-drive-explanation">{en?'Your next reminder gets closer with each trip.':'Met elke rit komt je volgende herinnering dichterbij.'}</p></article><article class="v2-drive-step" data-drive-step="2"><p class="v2-drive-number">03 / {en?'A reminder':'Een seintje'}</p><div class="v2-glass v2-drive-notice"><img src="/revly-logo.png" width="42" height="42" alt=""/><div><strong>{en?'Oil change':'Olie verversen'}</strong><p>{en?'You can change your oil in 300 km. Your car uses 5W30.':'Over 300 km kun je je olie verversen. Je gebruikt 5W30.'}</p></div></div><p class="v2-drive-explanation">{en?'Keep maintenance in sight, by date or mileage.':'Houd onderhoud in beeld, op datum of kilometerstand.'}</p><a class="v2-text-link" href="#onderhoud">{en?'See your maintenance':'Bekijk je onderhoud'} ›</a></article></div></div><p class="v2-drive-demo">{en?'Illustrative sequence with example data.':'Illustratief verloop met voorbeeldgegevens.'}</p></div></section>
<section class="v2-maintenance" id="onderhoud"><div class="v2-shell v2-maintenance-grid"><div class="v2-maintenance-copy"><p class="v2-overline">{en?'Maintenance':'Onderhoud'}</p><h2>{en?'A reminder.':'Een seintje.'}<br/><span>{en?'At the right time.':'Op het juiste moment.'}</span></h2><p>{en?'Set reminders by date or mileage. Keep track of what is coming up and what has already been done.':'Stel herinneringen in op datum of kilometerstand. Zo zie je wat eraan komt en wat er al aan je auto is gedaan.'}</p><a class="v2-text-link" href={`${base}app/#onderhoud`}>{en?'Explore maintenance':'Bekijk onderhoud'} <span aria-hidden="true">›</span></a></div><div class="v2-maintenance-visual"><Phone image="maintenance-current.jpg" alt={en?'Revly maintenance reminders, interface in Dutch':'Onderhoud en herinneringen in Revly'}/><div class="v2-reminder v2-glass"><img src="/revly-logo.png" width="38" height="38" alt=""/><div><strong>{en?'Oil change':'Olie verversen'}</strong><p>{en?'Due in 300 km. Your car uses 5W30.':'Over 300 km kun je je olie verversen. Je gebruikt 5W30.'}</p></div></div></div></div></section>
<section class="v2-insights v2-shell" id="inzicht"><div class="v2-section-heading"><div><p class="v2-overline">{en?'Know your numbers':'Ken je cijfers'}</p><h2>{en?'A clearer picture.':'Meer inzicht. Minder giswerk.'}</h2></div></div><div class="v2-insight-stage" data-insights={JSON.stringify(insights)}><div class="v2-insight-copy"><div class="v2-tabs" role="tablist" aria-label={en?'Explore insights':'Bekijk inzichten'}>{insights.map((item,k)=><button type="button" id={`insight-${item.id}`} role="tab" aria-controls="insight-panel" aria-selected={k===0?'true':'false'} tabindex={k===0?0:-1} data-insight={item.id}>{item.label}</button>)}</div><div id="insight-panel" role="tabpanel" aria-labelledby="insight-consumption"><h3 data-insight-title>{insights[0].title}</h3><p data-insight-text>{insights[0].text}</p><p class="v2-fine" data-insight-detail>{insights[0].detail}</p></div></div><div class="v2-insight-phone">{insights.map((item,k)=><div data-insight-screen={item.id} hidden={k!==0}><Phone image={item.image} alt={en?`Revly ${item.label} demo in Dutch`:`Revly ${item.label}, bewerkt voorbeeld`}/></div>)}</div></div></section>
<section class="v2-memory"><div class="v2-shell"><div class="v2-section-heading"><div><p class="v2-overline">{en?'Your cars':'Jouw auto’s'}</p><h2>{en?'Some cars stay with you.':'Sommige auto’s blijven je bij.'}</h2></div><p>{en?'Keep the history of the car you drive. And revisit the ones that came before.':'Bewaar de historie van de auto waarin je rijdt. En kijk terug naar de auto’s die eraan voorafgingen.'}</p></div><div class="v2-memory-grid"><figure class="v2-photo-story"><img src="/images/bmw-e30-example.jpg" width="1536" height="1024" loading="lazy" alt={en?'Illustrative classic BMW E30 at sunset':'Illustratieve klassieke BMW E30 bij zonsondergang'}/><figcaption><strong>{en?'For the miles you remember.':'Voor de kilometers die je bijblijven.'}</strong><span>{en?'Illustrative image':'Illustratieve afbeelding'}</span></figcaption></figure><article class="v2-previous-story"><div><h3>{en?'A place for your previous cars.':'Een plek voor je vorige auto’s.'}</h3><p>{en?'Find them in your profile, along with your current car.':'Je vindt ze terug in je profiel, naast de auto van nu.'}</p></div><Phone image="previous-cars-current.jpg" alt={en?'Revly profile showing previous cars':'Revly-profiel met vorige auto’s'}/></article></div></div></section>
<section class="v2-plus-teaser v2-shell" id="plus"><div><h2>{en?'Your first car is free.':'Je eerste auto gratis.'}<br/><span>{en?'More with Plus.':'Meer met Plus.'}</span></h2><p>{en?'Keep more cars, scan receipts and invoices, and get detailed cost insights.':'Houd meer auto’s bij, scan bonnen en facturen en krijg uitgebreid kosteninzicht.'}</p></div><a class="v2-button" href={`${base}plus/`}>{en?'Explore Plus':'Bekijk Plus'}</a></section>
<section class="v2-download" id="download"><div class="v2-shell"><img src="/revly-logo.png" width="72" height="72" alt=""/><h2>{en?'Your car has a story.':'Je auto heeft een verhaal.'}<br/><span>{en?'Keep it in Revly.':'Bewaar het in Revly.'}</span></h2><p>{en?'Free for your first car.':'Gratis voor je eerste auto.'}</p>{site.appStoreUrl?<a class="v2-button" href={site.appStoreUrl}>{en?'Download on the App Store':'Download in de App Store'}</a>:<p class="v2-coming">{en?'Coming soon to the App Store':'Binnenkort in de App Store'}</p>}<a class="v2-text-link" href={`${base}check/`}>{en?'Explore your car':'Check je auto'} ›</a></div></section>
</Layout>
<script>
const rail=document.querySelector<HTMLElement>('[data-feature-rail]');
const less=matchMedia('(prefers-reduced-motion: reduce)');
const arrows=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-dir]'));
function move(dir:number){if(!rail)return;const card=rail.querySelector<HTMLElement>('.v2-feature')!;rail.scrollBy({left:dir*(card.offsetWidth+24),behavior:less.matches?'instant':'smooth'});}
arrows.forEach(button=>button.addEventListener('click',()=>move(Number(button.dataset.galleryDir))));
function updateArrows(){if(!rail)return;arrows[0].disabled=rail.scrollLeft<3;arrows[1].disabled=rail.scrollLeft>=rail.scrollWidth-rail.clientWidth-3;}
rail?.addEventListener('scroll',updateArrows,{passive:true});addEventListener('resize',updateArrows);updateArrows();
rail?.addEventListener('keydown',event=>{if(event.key==='ArrowRight'||event.key==='ArrowLeft'){event.preventDefault();move(event.key==='ArrowRight'?1:-1);}});
const stage=document.querySelector<HTMLElement>('[data-insights]')!;
const options=JSON.parse(stage.dataset.insights!);const tabs=Array.from(stage.querySelectorAll<HTMLButtonElement>('[data-insight]'));
function pick(tab:HTMLButtonElement){const item=options.find((s:any)=>s.id===tab.dataset.insight);tabs.forEach(t=>{t.setAttribute('aria-selected',String(t===tab));t.tabIndex=t===tab?0:-1;});stage.querySelector('[data-insight-title]')!.textContent=item.title;stage.querySelector('[data-insight-text]')!.textContent=item.text;stage.querySelector('[data-insight-detail]')!.textContent=item.detail;stage.querySelectorAll<HTMLElement>('[data-insight-screen]').forEach(screen=>{screen.hidden=screen.dataset.insightScreen!==item.id;if(!screen.hidden&&!less.matches)screen.animate([{opacity:.3,transform:'translateX(12px)'},{opacity:1,transform:'translateX(0)'}],{duration:280,easing:'ease-out'});});document.getElementById('insight-panel')!.setAttribute('aria-labelledby',tab.id);}
tabs.forEach((t,k)=>{t.addEventListener('click',()=>pick(t));t.addEventListener('keydown',e=>{if(!['ArrowLeft','ArrowRight','Home','End'].includes(e.key))return;e.preventDefault();const n=e.key==='Home'?0:e.key==='End'?tabs.length-1:(k+(e.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length;pick(tabs[n]);tabs[n].focus();});});
const scene=document.querySelector<HTMLElement>('.v2-device-stage')!;
const drive=document.querySelector<HTMLElement>('.v2-drive')!;
const maintenance=document.querySelector<HTMLElement>('.v2-maintenance')!;
const maintenanceVisual=maintenance.querySelector<HTMLElement>('.v2-maintenance-visual')!;
const wide=matchMedia('(min-width: 901px)');
const steps=Array.from(document.querySelectorAll<HTMLElement>('[data-drive-step]'));
let queued=false;
let viewportHeight=document.documentElement.clientHeight;let viewportWidth=innerWidth;
function paint(){
 queued=false;const vh=viewportHeight;
 const pinned=wide.matches&&!less.matches;
 drive.classList.toggle('is-pinned',pinned);
 if(less.matches){
  scene.style.removeProperty('--progress');maintenance.style.removeProperty('--maintenance');drive.style.removeProperty('--drive');
  steps.forEach(step=>{step.classList.add('is-active');step.removeAttribute('aria-hidden');});
  return;
 }
 const r=scene.getBoundingClientRect();
 const p=Math.max(0,Math.min(1,(vh*.8-r.top)/(vh*.8+r.height*.35)));
 scene.style.setProperty('--progress',String(p));
 // Follow the visual, which sits below the copy on mobile.
 const m=maintenanceVisual.getBoundingClientRect();
 const mp=Math.max(0,Math.min(1,(vh*.85-m.top)/(vh*.85+m.height*.15)));
 maintenance.style.setProperty('--maintenance',String(mp));
 const d=drive.getBoundingClientRect();
 const road=drive.querySelector<HTMLElement>('.v2-drive-road')!;
 const roadBounds=road.getBoundingClientRect();
 const dp=Math.max(0,Math.min(1,pinned?-d.top/Math.max(1,d.height-vh):(vh*.45-roadBounds.top)/(roadBounds.height+vh*.4)));
 drive.style.setProperty('--drive',String(dp));
 drive.style.setProperty('--road-travel',Math.max(0,road.getBoundingClientRect().height-170)+'px');
 const current=Math.min(2,Math.floor(dp*3));
 steps.forEach((step,k)=>{step.classList.toggle('is-active',!pinned||k===current);if(pinned)step.setAttribute('aria-hidden',String(k!==current));else step.removeAttribute('aria-hidden');});
 document.querySelector('[data-drive-km]')!.textContent=Math.round(214320+Math.min(1,dp*1.5)*300).toLocaleString('nl-NL');
 document.querySelector('[data-drive-remaining]')!.textContent=String(Math.round(600-Math.min(1,dp*1.5)*300));
}
function schedule(){if(!queued){queued=true;requestAnimationFrame(paint);}}
addEventListener('scroll',schedule,{passive:true});addEventListener('resize',()=>{if(innerWidth!==viewportWidth){viewportWidth=innerWidth;viewportHeight=document.documentElement.clientHeight;}schedule();});less.addEventListener('change',schedule);wide.addEventListener('change',schedule);schedule();
</script>
