---
import site from '../../data/site.json';

interface Props {
  lang: 'nl' | 'en';
}

const { lang } = Astro.props;
const home = lang === 'nl' ? '/' : '/en/';
---
<footer class="site-footer">
    <div class="footer-grid">
      <div>
        <a class="footer-logo" href={home}><img src="/revly-logo.png" alt="" width="30" height="30" />Revly</a>
        <p>{lang === 'nl' ? 'Het logboek voor je auto. Gemaakt in Nederland door een autoliefhebber.' : 'The logbook for your car. Made in the Netherlands by a car enthusiast.'}</p>
        <p>
          <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
          {site.kvkNummer ? <><br />KvK {site.kvkNummer}</> : null}
          {site.adres ? <><br /><span set:html={site.adres.replace(/\n/g, '<br />')} /></> : null}
        </p>
      </div>
      {lang === 'nl' ? (
        <>
          <div><h2 class="ft">App</h2><a href="/app/">De app</a><a href="/plus/">Revly Plus</a><a href="/#download">Download</a></div>
          <div><h2 class="ft">Lezen</h2><a href="/check/">APK- en kentekencheck</a><a href="/autobegrippen/">Autobegrippen</a><a href="/blog/">Blog</a><a href="/verbruik/">Verbruik per model</a></div>
          <div><h2 class="ft">Hulp</h2><a href="/support/">Hulp en contact</a><a href="/privacy/">Privacyverklaring</a><a href="https://www.apple.com/legal/internet-services/itunes/dev/stdeula/">Gebruiksvoorwaarden</a></div>
        </>
      ) : (
        <>
          <div><h2 class="ft">App</h2><a href="/en/app/">The app</a><a href="/en/plus/">Revly Plus</a><a href="/en/#download">Download</a></div><div><h2 class="ft">Explore</h2><a href="/en/check/">Find your car</a><a href="/en/car-terms/">Car terms</a><a href="/en/blog/">Blog</a><a href="/en/verbruik/">Consumption by model</a></div>
          <div><h2 class="ft">Help</h2><a href="/en/support/">Help and contact</a><a href="/en/privacy/">Privacy policy</a><a href="https://www.apple.com/legal/internet-services/itunes/dev/stdeula/">Terms of use</a></div>
        </>
      )}
    </div>
  </footer>

<style>
  .site-footer {
    background: #f5f5f7;
    color: #515154;
    padding: 48px 0 24px;
    font-size: 15px;
    line-height: 1.5;
  }
  .footer-grid {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .ft {
    color: #1d1d1f;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: normal;
    margin: 0 0 8px;
  }
  a {
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .ft ~ a {
    display: block;
    margin-bottom: 6px;
  }
  a:hover { text-decoration: underline; }
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: #1d1d1f;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .footer-logo img { border-radius: 8px; }
  p { margin: 10px 0 0; }

  @media (max-width: 700px) {
    .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media print {
    .site-footer { display: none; }
  }
</style>
