---
import siteCopy from '../../data/site-copy.json';
import { isSiteLink } from '../../lib/site-links';
import site from '../../data/site.json';

interface Props {
  lang: 'nl' | 'en';
}

const { lang } = Astro.props;
const copy = siteCopy[lang];
const home = lang === 'nl' ? '/' : '/en/';
---
<footer class="site-footer">
    <div class="footer-grid">
      <div>
        <a class="footer-logo" href={home}><img src="/revly-logo.png" alt="" width="30" height="30" />Revly</a>
        <p>{copy.footerIntro}</p>
        <p>
          <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
          {site.kvkNummer ? <><br />KvK {site.kvkNummer}</> : null}
          {site.adres ? <><br /><span style="white-space:pre-line">{site.adres}</span></> : null}
        </p>
      </div>
      {copy.footerKolommen.map(column => (
        <div>
          <h2 class="ft">{column.kop}</h2>
          {column.links.filter(link => isSiteLink(link.url)).map(link => (
            <a href={link.url}>{link.label}</a>
          ))}
        </div>
      ))}
    </div>
  </footer>

<style>
  .site-footer {
    background: #f5f5f7;
    color: #515154;
    padding: 48px 0 24px;
    font-size: 15px;
    line-height: 1.5;
  }
  .footer-grid {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .ft {
    color: #1d1d1f;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: normal;
    margin: 0 0 8px;
  }
  a {
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .ft ~ a {
    display: block;
    margin-bottom: 6px;
  }
  a:hover { text-decoration: underline; }
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: #1d1d1f;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .footer-logo img { border-radius: 8px; }
  p { margin: 10px 0 0; }

  @media (max-width: 700px) {
    .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media print {
    .site-footer { display: none; }
  }
</style>
