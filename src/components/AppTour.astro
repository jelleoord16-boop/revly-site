---
import Base from '../layouts/Base.astro';
import StoreKnop from './StoreKnop.astro';
import DemoScreen from './v2/DemoScreen.astro';
const {lang='nl'}=Astro.props as {lang?:'nl'|'en'};
const en=lang==='en';
const sections=[
 {id:'garage',label:['Garage','Garage'],title:['Je auto. Alles bij elkaar.','Your car. All together.'],copy:['Je auto, kilometerstand en herinneringen op één plek. Leg een tankbeurt of onderhoud vast wanneer het jou uitkomt.','Your car, mileage and reminders in one place. Record a fill-up or maintenance whenever you need to.'],images:['garage-current.jpg','garage-overview'],captions:['Garage','Jaaroverzicht'],note:['','']},
 {id:'onderhoud',label:['Onderhoud','Maintenance'],title:['Zie wat eraan komt.','See what is coming up.'],copy:['Herinneringen op datum of kilometerstand helpen je vooruit te kijken. Bewaar ook wat er aan je auto is gedaan, met de kosten erbij.','Reminders by date or mileage help you plan ahead. Keep a record of the work done on your car, including the cost.'],images:['maintenance-current.jpg','maintenance-history'],captions:['Herinneringen','Onderhoudshistorie'],note:['De APK-weergave geldt voor Nederlandse kentekens.','The APK inspection shown applies to Dutch registrations.']},
 {id:'ritten',label:['Ritten','Trips'],title:['Van een rit naar overzicht.','From a trip to a clearer picture.'],copy:['Bekijk je geregistreerde ritten per maand. Open een rit voor de route, afstand en duur en geef aan of je privé of zakelijk reed.','Review your recorded trips by month. Open a trip for its route, distance and duration, and mark it as personal or business.'],images:['trips-current.jpg','trip-demo.png'],captions:['Rittenoverzicht','Ritdetail'],note:['Ritdetail bewerkt met fictieve voorbeeldadressen.','Trip detail edited with fictional example addresses.']},
 {id:'verbruik',label:['Verbruik','Consumption'],title:['Wat verbruikt jouw auto?','What does your car use?'],copy:['Je tankbeurten geven inzicht in je verbruik. Bekijk de ontwikkeling per maand en leg je eigen cijfers naast de officiële fabrieksopgave.','Your fill-ups give you insight into consumption. Follow it month by month and compare your figures with the official manufacturer rating.'],images:['consumption-current.jpg','consumption-history'],captions:['Verbruik en fabrieksopgave','Andere Revly-gebruikers en tankhistorie'],note:['De praktijkvergelijking met andere Revly-gebruikers toont hier fictieve voorbeelddata.','The comparison with other Revly users shows fictional example data here.']},
 {id:'kosten',label:['Kosten','Costs'],title:['Weet waar je geld blijft.','Know where your money goes.'],copy:['Van tanken en onderhoud tot verzekering en wegenbelasting. Bekijk je geregistreerde kosten per categorie en vergelijk de jaren. Uitgebreid kosteninzicht hoort bij Plus.','From fuel and maintenance to insurance and road tax. Review recorded costs by category and compare years. Detailed cost insights are part of Plus.'],images:['costs-current.jpg','costs-trends','costs-detail'],captions:['Kostenoverzicht','Jaren vergelijken','Aankoop en onderhoud'],note:['','']},
 {id:'delen',label:['Auto delen','Sharing'],title:['Eén auto, samen bijhouden.','One car, kept together.'],copy:['Nodig iemand uit voor het gedeelde autodossier en bekijk wie toegang heeft. Zo houd je de gegevens van jullie auto bij elkaar.','Invite someone to a shared vehicle record and see who has access. Keep the records for your car together.'],images:['sharing-current.jpg','sharing-settings'],captions:['Auto delen','Deelinstellingen'],note:['','']},
 {id:'vorige-autos',label:['Vorige auto’s','Previous cars'],title:['Ook je vorige auto’s horen erbij.','Your previous cars belong here, too.'],copy:['Een andere auto hoeft geen afscheid van je historie te zijn. Bekijk je vorige auto’s terug vanuit je profiel.','Changing cars does not have to mean losing your history. Revisit your previous cars from your profile.'],images:['previous-cars-current.jpg','previous-detail'],captions:['Vorige auto’s','Een vorige auto bekijken'],note:['De getoonde kentekenstatus is een Nederlandse functie.','The registration status shown is a Netherlands-specific feature.']},
 {id:'autopaspoort',label:['Autopaspoort','Vehicle passport'],title:['Een historie die je kunt laten zien.','A history you can show.'],copy:['Onderhoud, reparaties en documenten vertellen het verhaal van je auto. Houd ze samen in het autopaspoort en deel je historie wanneer je dat wilt.','Maintenance, repairs and documents tell your car’s story. Keep them together in a vehicle passport and share the history when you choose.'],images:['passport-current.jpg'],captions:['Autopaspoort'],note:['','']},
];
const i=en?1:0;
---
<Base lang={lang} tab="onderhoud" title={en?'Explore the Revly app | Garage, trips and maintenance':'Ontdek de Revly app | Garage, ritten en onderhoud'} description={en?'See real Revly screens for maintenance, trips, consumption, costs, car sharing and your vehicle history.':'Bekijk Revly in actie: onderhoud, ritten, verbruik, kosten, auto delen en de historie van je auto.'}>
<section class="tour-intro wrap"><div class="breadcrumb"><a href={en?'/en/':'/'}>Revly</a> / {en?'The app':'De app'}</div><h1>{en?'Get to know your car.':'Leer je auto kennen.'}</h1><p class="lead">{en?'A look inside Revly. From your next reminder to the cars you still remember.':'Een kijkje in Revly. Van je volgende herinnering tot de auto’s die je bijblijven.'}</p><nav class="tour-index" aria-label={en?'App examples':'Appvoorbeelden'}>{sections.map(s=><a href={`#${s.id}`}>{s.label[i]}</a>)}</nav><p class="tour-language-note">{en?'App screens edited with an illustrative BMW E30 and fictional example data. Interface shown in Dutch.':'Appschermen bewerkt met een BMW E30 en fictieve voorbeeldgegevens.'}</p></section>
<div class="tour-chapters wrap">{sections.map((s,index)=><section id={s.id} class={`tour-chapter ${index%2?'tour-reverse':''}`} aria-labelledby={`title-${s.id}`}><div class="tour-text"><span class="tour-eyebrow">{String(index+1).padStart(2,'0')} / {s.label[i]}</span><h2 id={`title-${s.id}`}>{s.title[i]}</h2><p>{s.copy[i]}</p>{s.note[i]&&<p class="tour-image-note">{s.note[i]}</p>}</div><div class="tour-media"><div class={`tour-rail ${s.images.length>1?'tour-rail-multiple':''}`} data-tour-rail tabindex={s.images.length>1?0:undefined} aria-label={en?`${s.label[i]} screenshots`:`Screenshots ${s.label[i]}`}>{s.images.map((image,k)=><figure class="tour-shot"><div class="tour-phone"><DemoScreen image={image} alt={en?`Revly ${s.label[1]} example ${k+1}, edited demo in Dutch`:`Revly ${s.captions[k]}, bewerkt voorbeeld`}/></div><figcaption>{en?`${s.label[1]} · ${k+1} / ${s.images.length}`:s.captions[k]}</figcaption></figure>)}</div>{s.images.length>1&&<div class="tour-pager" aria-label={en?'Choose an example':'Kies een voorbeeld'}>{s.images.map((_,k)=><button type="button" data-slide={k} aria-label={en?`Show example ${k+1}`:`Toon voorbeeld ${k+1}`} aria-pressed={k===0?'true':'false'}>{k+1}</button>)}<button type="button" data-gallery-next aria-label={en?'Next screenshot':'Volgend screenshot'}>→</button><span>{en?'Swipe for more':'Swipe voor meer'}</span></div>}</div></section>)}</div>
<section class="tour-download wrap"><h2>{en?'Your next chapter starts here.':'Klaar voor de volgende kilometers?'}</h2><p>{en?'Start with your first car for free.':'Begin gratis met je eerste auto.'}</p><div class="app-tour-actions"><StoreKnop lang={lang}/><a class="btn btn-secondary" href={en?'/en/plus/':'/plus/'}>{en?'Compare Free and Plus':'Vergelijk Gratis en Plus'}</a></div></section>
<script>
document.querySelectorAll<HTMLElement>('.tour-media').forEach(media=>{
 const rail=media.querySelector<HTMLElement>('[data-tour-rail]')!;
 const slides=Array.from(rail.querySelectorAll<HTMLElement>('.tour-shot'));
 const buttons=Array.from(media.querySelectorAll<HTMLButtonElement>('[data-slide]'));
 const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
 function choose(n:number){rail.scrollTo({left:slides[n].offsetLeft-slides[0].offsetLeft,behavior:reduced?'instant':'smooth'});}
 buttons.forEach((b,n)=>b.addEventListener('click',()=>choose(n)));
 media.querySelector('[data-gallery-next]')?.addEventListener('click',()=>{const active=buttons.findIndex(b=>b.getAttribute('aria-pressed')==='true');choose((active+1)%slides.length);});
 rail.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();const active=buttons.findIndex(b=>b.getAttribute('aria-pressed')==='true');choose(Math.max(0,Math.min(slides.length-1,active+(e.key==='ArrowRight'?1:-1))));}});
 rail.addEventListener('scroll',()=>{const index=slides.reduce((best,s,n)=>Math.abs(s.offsetLeft-slides[0].offsetLeft-rail.scrollLeft)<Math.abs(slides[best].offsetLeft-slides[0].offsetLeft-rail.scrollLeft)?n:best,0);buttons.forEach((b,n)=>b.setAttribute('aria-pressed',String(n===index)));},{passive:true});
});
</script>

</Base>
