---
import copy from '../data/pages/app.json';
import Base from '../layouts/Base.astro';
import StoreKnop from './StoreKnop.astro';
import DemoScreen from './v2/DemoScreen.astro';
const {lang='nl'}=Astro.props as {lang?:'nl'|'en'};
const en=lang==='en';
const sections=[
 {id:'garage',images:['garage-current.jpg','garage-overview'],captions:['Garage','Jaaroverzicht'],note:['','']},
 {id:'onderhoud',images:['maintenance-current.jpg','maintenance-history'],captions:['Herinneringen','Onderhoudshistorie'],note:['De APK-weergave geldt voor Nederlandse kentekens.','The APK inspection shown applies to Dutch registrations.']},
 {id:'ritten',images:['trips-current.jpg','trip-demo.png'],captions:['Rittenoverzicht','Ritdetail'],note:['Ritdetail bewerkt met fictieve voorbeeldadressen.','Trip detail edited with fictional example addresses.']},
 {id:'verbruik',images:['consumption-current.jpg','consumption-history'],captions:['Verbruik en fabrieksopgave','Andere Revly-gebruikers en tankhistorie'],note:['De praktijkvergelijking met andere Revly-gebruikers toont hier fictieve voorbeelddata.','The comparison with other Revly users shows fictional example data here.']},
 {id:'kosten',images:['costs-current.jpg','costs-trends','costs-detail'],captions:['Kostenoverzicht','Jaren vergelijken','Aankoop en onderhoud'],note:['','']},
 {id:'delen',images:['sharing-current.jpg','sharing-settings'],captions:['Auto delen','Deelinstellingen'],note:['','']},
 {id:'vorige-autos',images:['previous-cars-current.jpg','previous-detail'],captions:['Vorige auto’s','Een vorige auto bekijken'],note:['De getoonde kentekenstatus is een Nederlandse functie.','The registration status shown is a Netherlands-specific feature.']},
 {id:'autopaspoort',images:['passport-current.jpg'],captions:['Autopaspoort'],note:['','']},
] as const;
const i=en?1:0;
---
<Base lang={lang} tab="onderhoud" title={copy.seoTitel[lang].trim() || copy.kop[lang]} description={copy.meta[lang]}>
<section class="tour-intro wrap"><div class="breadcrumb"><a href={copy.broodkruimel[lang]}>Revly</a> / {copy.kop[lang]}</div><h1>{copy.intro[lang]}</h1><p class="lead">{en?'A look inside Revly. From your next reminder to the cars you still remember.':'Een kijkje in Revly. Van je volgende herinnering tot de auto’s die je bijblijven.'}</p><nav class="tour-index" aria-label={en?'App examples':'Appvoorbeelden'}>{sections.map(s=><a href={`#${s.id}`}>{copy.hoofdstukken[s.id][lang].label}</a>)}</nav><p class="tour-language-note">{en?'App screens edited with an illustrative BMW E30 and fictional example data. Interface shown in Dutch.':'Appschermen bewerkt met een BMW E30 en fictieve voorbeeldgegevens.'}</p></section>
<div class="tour-chapters wrap">{sections.map((s,index)=><section id={s.id} class={`tour-chapter ${index%2?'tour-reverse':''}`} aria-labelledby={`title-${s.id}`}><div class="tour-text"><span class="tour-eyebrow">{String(index+1).padStart(2,'0')} / {copy.hoofdstukken[s.id][lang].label}</span><h2 id={`title-${s.id}`}>{copy.hoofdstukken[s.id][lang].kop}</h2><p>{copy.hoofdstukken[s.id][lang].tekst}</p>{s.note[i]&&<p class="tour-image-note">{s.note[i]}</p>}</div><div class="tour-media"><div class={`tour-rail ${s.images.length>1?'tour-rail-multiple':''}`} data-tour-rail tabindex={s.images.length>1?0:undefined} aria-label={en?`${copy.hoofdstukken[s.id][lang].label} screenshots`:`Screenshots ${copy.hoofdstukken[s.id][lang].label}`}>{s.images.map((image,k)=><figure class="tour-shot"><div class="tour-phone"><DemoScreen image={image} alt={en?`Revly ${copy.hoofdstukken[s.id].en.label} example ${k+1}, edited demo in Dutch`:`Revly ${s.captions[k]}, bewerkt voorbeeld`}/></div><figcaption>{en?`${copy.hoofdstukken[s.id].en.label} · ${k+1} / ${s.images.length}`:s.captions[k]}</figcaption></figure>)}</div>{s.images.length>1&&<div class="tour-pager" aria-label={en?'Choose an example':'Kies een voorbeeld'}>{s.images.map((_,k)=><button type="button" data-slide={k} aria-label={en?`Show example ${k+1}`:`Toon voorbeeld ${k+1}`} aria-pressed={k===0?'true':'false'}>{k+1}</button>)}<button type="button" data-gallery-next aria-label={en?'Next screenshot':'Volgend screenshot'}>→</button><span>{en?'Swipe for more':'Swipe voor meer'}</span></div>}</div></section>)}</div>
<section class="tour-download wrap"><h2>{en?'Your next chapter starts here.':'Klaar voor de volgende kilometers?'}</h2><p>{en?'Start with your first car for free.':'Begin gratis met je eerste auto.'}</p><div class="app-tour-actions"><StoreKnop lang={lang}/><a class="btn btn-secondary" href={en?'/en/plus/':'/plus/'}>{en?'Compare Free and Plus':'Vergelijk Gratis en Plus'}</a></div></section>
<script>
document.querySelectorAll<HTMLElement>('.tour-media').forEach(media=>{
 const rail=media.querySelector<HTMLElement>('[data-tour-rail]')!;
 const slides=Array.from(rail.querySelectorAll<HTMLElement>('.tour-shot'));
 const buttons=Array.from(media.querySelectorAll<HTMLButtonElement>('[data-slide]'));
 const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
 function choose(n:number){rail.scrollTo({left:slides[n].offsetLeft-slides[0].offsetLeft,behavior:reduced?'instant':'smooth'});}
 buttons.forEach((b,n)=>b.addEventListener('click',()=>choose(n)));
 media.querySelector('[data-gallery-next]')?.addEventListener('click',()=>{const active=buttons.findIndex(b=>b.getAttribute('aria-pressed')==='true');choose((active+1)%slides.length);});
 rail.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();const active=buttons.findIndex(b=>b.getAttribute('aria-pressed')==='true');choose(Math.max(0,Math.min(slides.length-1,active+(e.key==='ArrowRight'?1:-1))));}});
 rail.addEventListener('scroll',()=>{const index=slides.reduce((best,s,n)=>Math.abs(s.offsetLeft-slides[0].offsetLeft-rail.scrollLeft)<Math.abs(slides[best].offsetLeft-slides[0].offsetLeft-rail.scrollLeft)?n:best,0);buttons.forEach((b,n)=>b.setAttribute('aria-pressed',String(n===index)));},{passive:true});
});
</script>

</Base>
