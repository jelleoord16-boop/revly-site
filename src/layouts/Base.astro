---
import '../styles/global.css';
import SiteFooter from '../components/v2/SiteFooter.astro';
import SiteHeader from '../components/v2/SiteHeader.astro';
import '../styles/version-two-pages.css';
import '../styles/revly-font.css';
import site from '../data/site.json';

interface Props {
  title: string;
  description: string;
  lang?: 'nl' | 'en';
  alternates?: { nl?: string; en?: string };
  noindex?: boolean;
  image?: string | null;
  canonical?: string;
  schema?: object | object[];
  ogType?: 'website' | 'article';
  tab?: 'home' | 'check' | 'onderhoud' | 'functies' | 'plus' | null;
  heroTop?: boolean;
  km?: boolean;
}

const {
  title,
  description,
  lang = 'nl',
  alternates = {},
  noindex = false,
  image,
  canonical,
  schema,
  ogType = 'website',
  tab = null,
  heroTop = false,
  km = false,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://getrevly.nl';
const path = Astro.url.pathname;
const canonicalUrl = canonical || siteUrl + path;
const ogImage = image ? siteUrl + image : siteUrl + '/og-revly.png';
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

const t = {
  nl: { functies: 'Functies', plus: 'Revly Plus', verbruik: 'Verbruik', blog: 'Blog', hulp: 'Hulp', andereTaal: 'EN', home: '/' },
  en: { functies: 'Features', plus: 'Revly Plus', verbruik: 'Fuel economy', blog: 'Blog', hulp: 'Help', andereTaal: 'NL', home: '/en/' },
}[lang];

const icons = {
  home: 'M3 11.5 12 4l9 7.5M5.5 10v9.5h13V10M10 19.5v-5h4v5',
  onderhoud: 'M14.5 6.5a4 4 0 0 0-5.3 5.3L4 17l3 3 5.2-5.2a4 4 0 0 0 5.3-5.3l-2.6 2.6-2.4-.6-.6-2.4z',
  functies: 'M4.5 4.5h6v6h-6zM13.5 4.5h6v6h-6zM4.5 13.5h6v6h-6zM13.5 13.5h6v6h-6z',
  check: 'M10.5 17a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13zM15.5 15.5 20 20M8 10.5l1.8 1.8 3.2-3.3',
  plus: 'M12 3.5l2.6 5.3 5.8.8-4.2 4.1 1 5.8L12 16.8l-5.2 2.7 1-5.8-4.2-4.1 5.8-.8z',
  verbruik: 'M5 20V5.5A1.5 1.5 0 0 1 6.5 4h6A1.5 1.5 0 0 1 14 5.5V20M3.5 20h12M7 8h5M14 10h2a1.5 1.5 0 0 1 1.5 1.5v5a1.5 1.5 0 0 0 3 0V9l-3-3',
  blog: 'M4 5.5C6.5 4 9.5 4 12 5.5 14.5 4 17.5 4 20 5.5V19c-2.5-1.5-5.5-1.5-8 0-2.5-1.5-5.5-1.5-8 0zM12 5.5V19',
  hulp: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6V14M12 17h.01',
};
const tabs = lang === 'nl'
  ? [
      { key: 'home', href: '/', label: 'Home', icon: icons.home },
      { key: 'check', href: '/check/', label: 'Check', icon: icons.check },
      { key: 'onderhoud', href: '/app/', label: 'De app', icon: icons.onderhoud },
      { key: 'functies', href: '/functies/', label: 'Functies', icon: icons.functies },
      { key: 'plus', href: '/plus/', label: 'Plus', icon: icons.plus },
    ]
  : [
      { key:'home',href:'/en/',label:'Home',icon:icons.home },
      { key:'check',href:'/en/check/',label:'Car',icon:icons.check },
      { key:'onderhoud',href:'/en/app/',label:'App',icon:icons.onderhoud },
      { key:'functies',href:'/en/functies/',label:'Features',icon:icons.functies },
      { key:'plus',href:'/en/plus/',label:'Plus',icon:icons.plus },
    ];

const counterparts:Record<string,string> = {'/autobegrippen/':'/en/car-terms/','/autobegrippen/5w30-motorolie/':'/en/car-terms/5w30-engine-oil/','/autobegrippen/onderhoudsinterval/':'/en/car-terms/service-interval/','/autobegrippen/kosten-per-kilometer/':'/en/car-terms/cost-per-kilometre/','/blog/verbruik-volvo-s60/':'/en/blog/volvo-s60-consumption/','/blog/distributieriem-vervangen/':'/en/blog/when-to-replace-timing-belt/'};
const normalizedPath = path.endsWith('/') ? path : path + '/';
const reverseCounterpart = Object.entries(counterparts).find(([,en])=>en===normalizedPath)?.[0];
const otherLangHref = lang === 'nl' ? (counterparts[normalizedPath] ?? '/en' + normalizedPath) : (reverseCounterpart ?? (normalizedPath.replace(/^\/en/, '') || '/'));
const resolvedAlternates = lang === 'en' ? {nl:otherLangHref,en:normalizedPath} : {nl:normalizedPath,en:otherLangHref};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="noindex,nofollow" />
  {resolvedAlternates.nl && <link rel="alternate" hreflang="nl" href={siteUrl + resolvedAlternates.nl} />}
  {resolvedAlternates.en && <link rel="alternate" hreflang="en" href={siteUrl + resolvedAlternates.en} />}
  {resolvedAlternates.nl && <link rel="alternate" hreflang="x-default" href={siteUrl + resolvedAlternates.nl} />}
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={lang === 'nl' ? 'nl_NL' : 'en_GB'} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#F2F2F7" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
  {site.appStoreUrl && <meta name="apple-itunes-app" content={`app-id=${site.appStoreUrl.match(/id(\d+)/)?.[1] ?? ''}`} />}
  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <script is:inline>if (new URLSearchParams(location.search).has('app')) document.documentElement.classList.add('app');</script>
</head>
<body>
  <SiteHeader lang={lang} otherLangHref={otherLangHref}/>

  <main>
    <slot />
  </main>

  <SiteFooter lang={lang} />

<script>import '../lib/scroll-scenes';</script>
</body>
</html>
