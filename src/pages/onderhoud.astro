---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

// Richtwaarden uit de app (MaintenanceType.defaultInterval in revly-ios). Check altijd het instructieboekje.
const intervallen = [
  ['Kleine beurt', '15.000 km', '12 maanden'],
  ['Grote beurt', '30.000 km', '24 maanden'],
  ['Olie en oliefilter', '15.000 km', '12 maanden'],
  ['Distributieriem', '120.000 km', '6 jaar'],
  ['Remvloeistof', '', '2 jaar'],
  ['Koelvloeistof', '', '3 jaar'],
  ['Versnellingsbakolie', '60.000 km', '6 jaar'],
  ['Filters', '30.000 km', '2 jaar'],
  ['Remmen', '40.000 km', ''],
  ['Ophanging controleren', '', 'elk jaar'],
  ['Banden', '40.000 km', '6 jaar'],
  ['Airco', '', '2 jaar'],
];

const posts = (await getCollection('blog', (p) => p.data.status === 'gepubliceerd' && p.data.taal === 'nl'))
  .sort((a, b) => (b.data.datum?.getTime() ?? 0) - (a.data.datum?.getTime() ?? 0));
---
<Base
  title="Onderhoud van je auto: intervallen per onderdeel | Revly"
  description="Wanneer moet je olie, distributieriem, remvloeistof of banden vervangen? De richtwaarden per onderdeel op een rij, met artikelen over onderhoud van je auto."
  alternates={{ nl: '/onderhoud/' }}
  tab="onderhoud"
>
  <section class="section" style="padding-top:40px">
    <div class="wrap">
      <div class="breadcrumb"><a href="/">Revly</a> / Onderhoud</div>
      <h1 style="font-size:clamp(40px,6vw,76px)">Onderhoud, onderdeel voor onderdeel.</h1>
      <p class="lead">Dit zijn de richtwaarden waarmee Revly rekent. Wat het eerst komt, telt. Je past ze in de app aan op wat in het instructieboekje van jouw auto staat.</p>
      <div style="overflow-x:auto;margin-top:28px">
        <table class="intervals">
          <thead><tr><th>Onderdeel</th><th>Kilometers</th><th>Tijd</th></tr></thead>
          <tbody>
            {intervallen.map(([naam, km, tijd]) => (
              <tr><td><strong>{naam}</strong></td><td class="num">{km || <span class="muted">Niet van toepassing</span>}</td><td>{tijd || <span class="muted">Niet van toepassing</span>}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="notice">Richtwaarden, geen fabrieksvoorschrift. Een elektrische auto heeft geen distributieriem en olie, en langere intervallen voor de beurt. <a href="/check/">Check je eigen auto</a></p>
    </div>
  </section>

  <section class="section" style="background:var(--card)">
    <div class="wrap">
      <h2>Lezen over onderhoud</h2>
      <div class="grid-3" style="margin-top:24px">
        {posts.map((p) => (
          <a class="card post-item" style="background:var(--bg)" href={`/blog/${p.id}/`}>
            <p class="meta">{p.data.datum?.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
            <h3>{p.data.titel}</h3>
            <p class="muted">{p.data.samenvatting}</p>
          </a>
        ))}
      </div>
      <p style="margin-top:20px;display:flex;gap:24px;flex-wrap:wrap"><a href="/blog/" style="font-weight:700">Alle artikelen</a><a href="/verbruik/" style="font-weight:700">Verbruik per model</a></p>
    </div>
  </section>
</Base>
