---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', (p) => p.data.status === 'gepubliceerd' && p.data.taal === 'nl'))
  .sort((a, b) => (b.data.datum?.getTime() ?? 0) - (a.data.datum?.getTime() ?? 0));
---
<Base
  tab="onderhoud"
  title="Blog over auto-onderhoud | Revly"
  description="Praktische artikelen over onderhoud van je auto: APK, distributieriem, banden, accu en verbruik. Geschreven voor wie zijn auto lang wil houden."
  alternates={{ nl: '/blog/' }}
>
  <section class="section">
    <div class="prose">
      <div class="breadcrumb"><a href="/">Revly</a> / Blog</div>
      <h1>Blog</h1>
      <p class="lead">Over onderhoud, kosten en het langer houden van je auto.</p>
      <div class="post-list" style="margin-top:32px">
        {posts.map((p) => (
          <a class="card post-item" href={`/blog/${p.id}/`}>
            <p class="meta">{p.data.datum?.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
            <h2 style="font-size:21px;letter-spacing:-0.015em;line-height:1.2;margin:0 0 6px">{p.data.titel}</h2>
            <p class="muted">{p.data.samenvatting}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
