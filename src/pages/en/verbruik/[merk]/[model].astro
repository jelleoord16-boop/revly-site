---
import Base from '../../../../layouts/Base.astro';
import StoreKnop from '../../../../components/StoreKnop.astro';
import data from '../../../../data/verbruik.json';
import { genoegData, fmt, verschil, afgerondKm, afgerondAantal } from '../../../../lib/verbruik';

export function getStaticPaths() {
  return data.modellen.map((m) => ({ params: { merk: m.merkSlug, model: m.modelSlug }, props: { m } }));
}

const { m } = Astro.props;
const ok = genoegData(m, data.drempel);
const naam = `${m.merk} ${m.model}`;
const seizoenen = m.perSeizoen ? Object.entries(m.perSeizoen) : [];
const max = Math.max(m.revly.gemiddelde, m.rdw, ...seizoenen.map(([, v]) => v as number)) * 1.1;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `Sample fuel consumption for ${naam}`,
  description: `Illustrative consumption comparison for ${naam}, with sample real-world and official reference figures.`,
  creator: { '@type': 'Organization', name: 'Revly' },
  dateModified: data.bijgewerkt,
  variableMeasured: 'Fuelverbruik in liters per 100 km',
};
---
<Base
  lang="en"
  tab="check"
  title={`Consumption ${naam}: official and real-world figures`}
  description={`Sample consumption comparison for the ${naam}: official figures and illustrative real-world averages.`}
  alternates={{ nl: `/en/verbruik/${m.merkSlug}/${m.modelSlug}/` }}
  schema={schema}
  noindex={!ok}
>
  <section class="section">
    <div class="prose">
      <div class="breadcrumb"><a href="/en/">Revly</a> / <a href="/en/verbruik/">Consumption</a> / {naam}</div>
      <h1>Consumption {naam}</h1>
      <p class="lead">{m.brandstof === 'Benzine' ? 'Petrol' : 'Diesel'}, model years {m.bouwjaren}. <span class="demo-label">Sample data</span></p>

      {ok ? (
        <>
          <div class="consumption-summary glass-surface">
          <div class="stat-grid" style="margin-top:24px">
            <div class="stat"><div class="label">Revly drivers</div><div class="value">{fmt(m.revly.gemiddelde)} <small>l/100 km</small></div></div>
            <div class="stat"><div class="label">Official figure</div><div class="value">{fmt(m.rdw)} <small>l/100 km</small></div></div>
            <div class="stat"><div class="label">Difference</div><div class="value">+{verschil(m)}<small>%</small></div></div>
          </div>

          <h2 style="margin-top:40px">Real-world and official consumption</h2>
          <p>Compare the sample real-world average with the official figure. These preview numbers are illustrative, not verified participant measurements.</p>
          <div class="bars">
            <div class="bar"><span>Revly drivers</span><div class="track"><div class="fill" style={`width:${(m.revly.gemiddelde / max) * 100}%`}></div></div><strong class="num">{fmt(m.revly.gemiddelde)} l</strong></div>
            <div class="bar"><span>Official figure</span><div class="track"><div class="fill ref" style={`width:${(m.rdw / max) * 100}%`}></div></div><span class="num">{fmt(m.rdw)} l</span></div>
          </div>

          {seizoenen.length > 0 && (
            <>
              <h2 style="margin-top:40px">By season</h2>
              <p>Cold starts, shorter journeys and heating can affect consumption in winter.</p>
              <div class="bars">
                {seizoenen.map(([s, v]) => (
                  <div class="bar"><span style="text-transform:capitalize">{({winter:'Winter',lente:'Spring',zomer:'Summer',herfst:'Autumn'} as Record<string,string>)[s]}</span><div class="track"><div class="fill" style={`width:${((v as number) / max) * 100}%`}></div></div><span class="num">{fmt(v as number)} l</span></div>
                ))}
              </div>
            </>
          )}
          </div>

          <h2 style="margin-top:40px">How the measurement works</h2>
          <p>Revly calculates consumption from recorded full fill-ups and distance. Optional contributions use aggregated totals. The numbers on this preview page remain sample data.</p>
          <p class="muted" style="font-size:15px">Sample group distance: {afgerondKm(m.revly.kilometers)} km. Real publication requires the configured contribution thresholds.</p>
        </>
      ) : (
        <div class="card" style="margin-top:24px">
          <h3>Not enough data yet</h3>
          <p class="muted">There is not enough sample data for this model. The official reference is {fmt(m.rdw)} l/100 km.</p>
        </div>
      )}

      <div class="cta-box">
        <div><strong style="font-size:20px">Drive a {m.merk}?</strong><p>Record your consumption in Revly.</p></div>
        <StoreKnop lang="en" />
      </div>
    </div>
  </section>
</Base>
