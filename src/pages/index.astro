---
import HeroApp from '../components/HeroApp.astro';
import PlusPreview from '../components/PlusPreview.astro';
import Base from '../layouts/Base.astro';
import StoreKnop from '../components/StoreKnop.astro';
import site from '../data/site.json';
import verbruik from '../data/verbruik.json';
import { fmt, genoegData, verschil, afgerondKm, afgerondAantal } from '../lib/verbruik';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', (p) => p.data.status === 'gepubliceerd' && p.data.taal === 'nl'))
  .sort((a, b) => (b.data.datum?.getTime() ?? 0) - (a.data.datum?.getTime() ?? 0))
  .slice(0, 3);
const vragen = await getCollection('vragen', (v) => v.data.opHome);

// Alleen modellen met genoeg rijders, dezelfde drempel als in de privacyverklaring.
const modellen = verbruik.modellen
  .filter((m) => genoegData(m, verbruik.drempel) && m.perSeizoen)
  .sort((a, b) => b.revly.deelnemers - a.revly.deelnemers)
  .map((m) => {
    const waarden = Object.entries(m.perSeizoen ?? {}).map(([naam, v]) => ({ naam: naam[0].toUpperCase() + naam.slice(1), v: v as number }));
    const max = Math.max(...waarden.map((w) => w.v));
    const min = Math.min(...waarden.map((w) => w.v));
    const d = verschil(m);
    return {
      id: m.id, merk: m.merk, model: m.model, brandstof: m.brandstof,
      revlyTekst: fmt(m.revly.gemiddelde), rdwTekst: fmt(m.rdw),
      verschilTekst: `${d > 0 ? '+' : ''}${d}%`,
      bron: `Gemeten door ${afgerondAantal(m.revly.deelnemers)} rijders over ${afgerondKm(m.revly.kilometers)} km.`,
      href: `/verbruik/${m.merkSlug}/${m.modelSlug}/`,
      revly: m.revly, rdw: m.rdw,
      seizoenen: waarden.map((w) => ({ naam: w.naam, tekst: fmt(w.v), hot: w.v === max, hoogte: Math.round(50 + ((w.v - min) / Math.max(0.1, max - min)) * 90) })),
    };
  });
const eerste = modellen[0];

const stops = [
  { marker: 'Maandag, 214.320 km', titel: 'Rit herkend', tekst: 'Thuis naar werk, 23 km. Reed jij in de Volvo?', uitleg: 'Revly ziet dat je rijdt, ook via CarPlay. Eén tik en de rit telt mee.' },
  { marker: 'Dinsdag, 214.680 km', titel: 'Olie verversen', tekst: 'Over 320 km is je olie aan de beurt. Je gebruikt 5W30.', uitleg: 'Na het interval dat jij kiest, met de olie die in jouw auto hoort.' },
  { marker: 'Woensdag, 4 graden', titel: 'Winterbanden', tekst: 'Morgen wordt het kouder dan 7 graden. Tijd om te wisselen?', uitleg: 'Revly kijkt naar het weer bij jou in de buurt.' },
  { marker: 'Donderdag', titel: 'Je kunt je APK nu laten doen', tekst: 'Je APK verloopt op 8 januari. Keur je nu, dan verlies je geen tijd.', uitleg: 'Twee maanden van tevoren, en nog eens twee weken voor de vervaldatum. Met garages in de buurt op de kaart.' },
  { marker: 'Vrijdag, 215.140 km', titel: 'Je hebt 820 km gereden', tekst: 'Gemiddeld 10,2 liter per 100 km. Zuiniger dan vorige week.', uitleg: 'Revly rekent je verbruik uit je tankbeurten, zonder dat je iets hoeft te doen.' },
];

const features = [
  ['Logboek', 'Elke beurt, reparatie en tankbeurt op één plek. Scan je factuur en Revly vult het meeste in.', 'M7 3.5h8l3 3V20.5H7zM15 3.5V7h3M10 11h5M10 14.5h5M10 18h3'],
  ['Autopaspoort', 'Verkoop je de auto? Deel de hele historie als nette pdf, met de facturen erbij.', 'M5 4h14v16H5zM9 9a3 3 0 1 0 6 0 3 3 0 0 0-6 0M8 16.5c1-1.5 2.4-2 4-2s3 .5 4 2'],
  ['Kaart', 'Garages, tankstations en laadpunten in de buurt, met route en telefoonnummer.', 'M12 21s-6.5-5.7-6.5-11a6.5 6.5 0 0 1 13 0c0 5.3-6.5 11-6.5 11zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z'],
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: 'Revly',
    operatingSystem: 'iOS 26 of nieuwer',
    applicationCategory: 'LifestyleApplication',
    inLanguage: ['nl', 'en'],
    description: 'Revly houdt het onderhoud van je auto bij, van logboek tot autopaspoort.',
    offers: [
      { '@type': 'Offer', price: '0', priceCurrency: 'EUR', name: 'Revly' },
      { '@type': 'Offer', price: site.prijsJaar.replace(',', '.'), priceCurrency: 'EUR', name: 'Revly Plus per jaar' },
    ],
  },
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Revly', url: 'https://getrevly.nl', email: site.supportEmail },
  ...(vragen.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: vragen.map((v) => ({ '@type': 'Question', name: v.data.vraag, acceptedAnswer: { '@type': 'Answer', text: v.data.antwoord } })),
      }]
    : []),
];
---
<Base
  title="Revly: het logboek voor je auto"
  description="Houd onderhoud, APK, ritten en kosten van je auto bij in één app. Revly herkent je ritten en zegt op tijd wanneer er iets moet. Gratis voor je eerste auto."
  alternates={{ nl: '/', en: '/en/' }}
  schema={schema}
  tab="home"
  heroTop
  km
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>Rij.<br />Revly onthoudt de rest.</h1>
        <p class="lead">Het logboek voor je auto. Revly herkent je ritten, telt je kilometers en zegt op tijd wanneer er iets moet. Ook als je auto ouder is dan je telefoon. Gratis voor je eerste auto.</p>
        <div id="download" style="display:flex;gap:14px;flex-wrap:wrap;align-items:center;margin-top:28px">
          <StoreKnop />
          <a class="btn btn-light" href="/check/">Check je auto</a>
        </div>
      </div>
      <HeroApp lang="nl" />
    </div>
  </section>

  <section class="section ride-section" id="een-week">
    <div class="wrap">
      <h2 style="max-width:860px">Scroll mee. Zo rijdt een week met Revly.</h2>
      <p class="lead" style="margin-bottom:56px">Je hoeft niets bij te houden. Revly telt mee en geeft pas een seintje als het ertoe doet.</p>
      <div class="ride">
        <div class="road">
          <div class="road-car">
            <svg width="58" height="102" viewBox="0 0 64 112" role="img" aria-label="Auto rijdt vooruit langs de weg">
              <rect x="6" y="4" width="52" height="104" rx="18" fill="#3B85FD" stroke="#E5E5EA" stroke-width="2.5" />
              <path d="M14 34 Q32 24 50 34 L47 50 H17 Z" fill="#1C1C1E" />
              <path d="M17 84 H47 L50 96 Q32 102 14 96 Z" fill="#1C1C1E" opacity=".85" />
              <rect x="12" y="8" width="10" height="6" rx="2" fill="#fff" />
              <rect x="42" y="8" width="10" height="6" rx="2" fill="#fff" />
            </svg>
          </div>
        </div>
        <div class="stops">
          {stops.map((s) => (
            <div class="stop">
              <span class="stop-marker">{s.marker}</span>
              <div class="notif-wrap">
                <div class="notif glass">
                  <div class="notif-icon" aria-hidden="true"><img src="/revly-logo.png" alt="" width="40" height="40" loading="lazy" /></div>
                  <div style="flex:1;min-width:0">
                    <div style="display:flex;justify-content:space-between;gap:12px"><strong>{s.titel}</strong><span style="font-size:13px">nu</span></div>
                    <div class="t">{s.tekst}</div>
                  </div>
                </div>
              </div>
              <p class="muted" style="margin:0;font-size:18px">{s.uitleg}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section consumption-section" id="verbruik">
    <div class="wrap split">
      <div>
        <h2>Wat verbruikt jouw auto echt?</h2>
        <p class="lead">Revly-rijders delen anoniem hun verbruik, als ze dat willen. Zo zie je per model wat de praktijk doet, naast de officiële opgave.</p>
        <div class="chips" role="group" aria-label="Kies een model">
          {modellen.map((m, i) => (
            <button type="button" class="chip" aria-pressed={i === 0 ? 'true' : 'false'} data-model={m.id}>{m.merk} {m.model}</button>
          ))}
        </div>
        <p style="margin-top:18px"><a href="/verbruik/" style="font-weight:700">Alle modellen</a> <span class="demo-label">Voorbeelddata</span></p>
      </div>
      <div class="vb-card" id="vb" data-modellen={JSON.stringify(modellen)}>
        <p class="vb-naam" id="vb-naam">{eerste.merk} {eerste.model}, {eerste.brandstof.toLowerCase()}</p>
        <div style="display:flex;gap:32px;flex-wrap:wrap;margin-bottom:24px">
          <div><div class="muted" style="font-size:15px">Revly-rijders</div><div class="vb-big"><span id="vb-revly">{fmt(eerste.revly.gemiddelde)}</span> <span class="vb-unit">l/100 km</span></div></div>
          <div><div class="muted" style="font-size:15px">Officiële opgave</div><div class="vb-big muted" id="vb-rdw">{fmt(eerste.rdw)}</div></div>
          <div><div class="muted" style="font-size:15px">Verschil</div><div class="vb-big" id="vb-verschil">{eerste.verschilTekst}</div></div>
        </div>
        <div style="font-size:15px;font-weight:700;margin-bottom:10px">Per seizoen</div>
        <div class="columns" id="vb-cols">
          {eerste.seizoenen.map((z) => (
            <div class={z.hot ? 'column hot' : 'column'}>
              <span class="num" style="font-weight:700;font-size:15px">{z.tekst}</span>
              <div class="b" style={`height:${z.hoogte}px`}></div>
              <span class="muted" style="font-size:14px">{z.naam}</span>
            </div>
          ))}
        </div>
        <p class="muted" style="font-size:15px;margin:18px 0 0"><span id="vb-bron">{eerste.bron}</span> <a id="vb-link" href={eerste.href}>Alle cijfers</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>En verder</h2>
      <div class="grid-3 surface-stage" style="margin-top:28px">
        {features.map(([titel, tekst, icon]) => (
          <div class="card feature glass-surface">
            <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon} /></svg></div>
            <h3>{titel}</h3>
            <p class="muted">{tekst}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:20px"><a href="/functies/" style="font-weight:700">Alle functies</a></p>
    </div>
  </section>

  <PlusPreview lang="nl" />

  {posts.length > 0 && (
    <section class="section" style="background:var(--card)">
      <div class="wrap">
        <h2>Blog</h2>
        <div class="grid-3 surface-stage" style="margin-top:24px">
          {posts.map((p) => (
            <a class="card post-item glass-surface" href={`/blog/${p.id}/`}>
              <p class="meta">{p.data.datum?.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
              <h3>{p.data.titel}</h3>
              <p class="muted">{p.data.samenvatting}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {vragen.length > 0 && (
    <section class="section">
      <div class="prose">
        <h2>Veelgestelde vragen</h2>
        {vragen.map((v) => (
          <details class="card glass-surface" style="margin-top:10px"><summary style="font-weight:700;cursor:pointer">{v.data.vraag}</summary><p class="muted" style="margin-top:10px">{v.data.antwoord}</p></details>
        ))}
      </div>
    </section>
  )}

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var el = document.getElementById('tab-km');
      if (!el) return;
      var start = 214320, extra = 6400, ticking = false;
      function update() {
        var max = document.documentElement.scrollHeight - window.innerHeight;
        var p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
        el.textContent = (start + Math.round(p * extra)).toLocaleString('nl-NL') + ' km';
        ticking = false;
      }
      window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      update();

      var vb = document.getElementById('vb');
      if (!vb) return;
      var data = JSON.parse(vb.getAttribute('data-modellen'));
      var chips = document.querySelectorAll('.chip');
      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          var m = data.find(function (x) { return x.id === chip.dataset.model; });
          if (!m) return;
          chips.forEach(function (c) { c.setAttribute('aria-pressed', c === chip ? 'true' : 'false'); });
          document.getElementById('vb-naam').textContent = m.merk + ' ' + m.model + ', ' + m.brandstof.toLowerCase();
          document.getElementById('vb-revly').textContent = m.revlyTekst;
          document.getElementById('vb-rdw').textContent = m.rdwTekst;
          document.getElementById('vb-verschil').textContent = m.verschilTekst;
          document.getElementById('vb-bron').textContent = m.bron;
          document.getElementById('vb-link').setAttribute('href', m.href);
          var cols = document.querySelectorAll('#vb-cols .column');
          m.seizoenen.forEach(function (z, i) {
            var col = cols[i]; if (!col) return;
            col.className = z.hot ? 'column hot' : 'column';
            col.children[0].textContent = z.tekst;
            col.children[1].style.height = z.hoogte + 'px';
            col.children[2].textContent = z.naam;
          });
        });
      });
    });
  </script>
</Base>
