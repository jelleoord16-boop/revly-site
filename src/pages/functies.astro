---
import Base from '../layouts/Base.astro';
import StoreKnop from '../components/StoreKnop.astro';

const groepen = [
  {
    titel: 'Onderhoud en logboek',
    tekst: 'Leg elke beurt vast, of je hem nu zelf deed of bij de garage. Kies wat er is gedaan, welke olie erin ging en wat het kostte.',
    punten: ['Kleine en grote beurt, reparaties en onderdelen', 'Garage of zelf gedaan, met olietype zoals 5W30', 'Factuur scannen, ook als pdf', 'Onderhoudsboekje overnemen met je camera', 'Onderhoudsrapport als pdf'],
  },
  {
    titel: 'Meldingen',
    tekst: 'Revly kijkt naar kilometers, leeftijd en het weer. Je krijgt een seintje op het moment dat het ertoe doet.',
    punten: ['APK twee maanden en twee weken van tevoren, met garages in de buurt', 'Olie, distributieriem, remvloeistof en banden', 'Winterbanden onder 7 graden', 'Accutest voor de winter', 'Per soort aan of uit te zetten'],
  },
  {
    titel: 'Ritten',
    tekst: 'Zet ritten bijhouden aan en Revly herkent je autoritten. Jij bevestigt of je reed, en in welke auto.',
    punten: ['Automatisch herkennen, ook via CarPlay', 'Kilometerstand loopt vanzelf op', 'Gemiste ritten van de afgelopen week toevoegen', 'Zakelijke rittenadministratie met Plus', 'Routes alleen op je telefoon'],
  },
  {
    titel: 'Autopaspoort',
    tekst: 'Alles wat je van je auto weet in één overzicht. Handig bij verkoop, of gewoon voor jezelf.',
    punten: ['Historie, facturen en taxaties', 'Delen als pdf', 'Je vorige auto\'s blijven gratis bewaard', 'Zien of je oude auto nog rijdt'],
  },
];
---
<Base
  tab="functies"
  title="Functies van Revly: onderhoud, meldingen en ritten"
  description="Alles wat Revly voor je auto doet: onderhoudslogboek, slimme meldingen, automatisch ritten bijhouden en een autopaspoort om te delen."
  alternates={{ nl: '/functies/' }}
>
  <section class="section">
    <div class="wrap">
      <div class="breadcrumb"><a href="/">Revly</a> / Functies</div>
      <h1>Alles wat Revly voor je auto doet</h1>
      <p class="lead">Gemaakt voor mensen die hun auto lang willen houden, en willen weten wat er onder de motorkap gebeurt.</p>
      <div class="grid-2" style="margin-top:36px">
        {groepen.map((g) => (
          <div class="card">
            <h2 style="font-size:24px">{g.titel}</h2>
            <p class="muted">{g.tekst}</p>
            <ul class="checklist">{g.punten.map((p) => <li>{p}</li>)}</ul>
          </div>
        ))}
      </div>
      <div class="cta-box">
        <div><strong style="font-size:20px">Probeer Revly met je eigen auto</strong><p>Kenteken invullen en Revly haalt de gegevens op bij de RDW.</p></div>
        <StoreKnop />
      </div>
    </div>
  </section>
</Base>
